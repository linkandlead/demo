# Alles optioneel. Zonder waarden draait NOVA op demodata en verstuurt het niets.
# Zie docs/cms-koppeling.md. Echte waarden horen in Vercel of .env.local, nooit in git.
CMS_URL=
# Leestoken van de site Demo Klant. Ook gebruikt voor "Voorbeeld op de site" (/__voorvertoning):
# het CMS controleert het voorvertoningstoken samen met dit token; de site heeft geen eigen geheim.
# Bewerken op de site (/api/cms-bewerken) stuurt het, alleen serverkant, mee met het bewerktoken.
CMS_TOKEN=
CMS_LEAD_SITE_ID=
LEAD_PROXY_SECRET=
DEMO_AANVRAAG_URL=
# NOVA-demodatabase (Supabase-project "demo"). Publieke sleutel; RLS bepaalt de rechten.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Directe verversing na publiceren: hetzelfde geheim als de webhook "Inhoud gepubliceerd" in het CMS
# (Beheer → Webhooks, adres https://demo.linkandlead.nl/api/cms-webhook).
CMS_WEBHOOK_SECRET=
# Mailvrije melding van nieuwe inzendingen naar een https-webhook (Slack, Discord, Zapier …).
INZENDING_WEBHOOK_URL=
INZENDING_WEBHOOK_SECRET=
# Limiet per bezoeker (inzendingen per 10 minuten, standaard 8) en een eigen zout voor de IP-hash.
INZENDING_LIMIET=
INZENDING_ZOUT=
# Zoekmachines toelaten (robots.txt, robots-meta, sitemap). Standaard uit: dit is een demo.
SITE_INDEXEREN=

# Adres van het beheer van het CMS als dat anders is dan CMS_URL (mag de voorvertoning insluiten in de editor).
CMS_BEHEER_URL=https://cms.linkandlead.nl
