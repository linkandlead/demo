# Alles optioneel. Zonder waarden draait NOVA op demodata en verstuurt het niets.
# Zie docs/cms-koppeling.md. Echte waarden horen in Vercel of .env.local, nooit in git.
CMS_URL=
# Leestoken van de site Demo Klant. Ook gebruikt voor "Voorbeeld op de site" (/__voorvertoning):
# het CMS controleert het voorvertoningstoken samen met dit token; de site heeft geen eigen geheim.
# Bewerken op de site (/api/cms-bewerken) stuurt het, alleen serverkant, mee met het bewerktoken.
CMS_TOKEN=
CMS_LEAD_SITE_ID=
LEAD_PROXY_SECRET=
DEMO_AANVRAAG_URL=
# NOVA-demodatabase (Supabase-project "demo"). Publieke sleutel; RLS bepaalt de rechten.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
